// Build settings shared by every target of the Day by Word app (BUILD.md P1.5).
// The signing team lives in the gitignored Secrets.xcconfig; copy
// Secrets.example.xcconfig to create it. Builds for the simulator need no team.
#include? "Secrets.xcconfig"

// Swift 6 language mode with complete concurrency checking, and no warnings.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// iPhone and iPad, iOS and iPadOS 26 and later (D7).
SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2

// Versions. make testflight sets CURRENT_PROJECT_VERSION for each upload.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

// Colors come from the generated Palette (apple/Shared/DesignTokens.swift),
// not from Xcode's generated asset symbols.
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = NO
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
