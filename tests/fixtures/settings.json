  "settings": [
    {
      "name": "appearance",
      "values": [
        "automatic",
        "light",
        "dark"
      ],
      "defaultValue": "automatic",
      "web": {
        "field": "appearance",
        "storageKey": "dbw.appearance"
      },
      "app": {
        "storageKey": "appearance"
      }
    },
    {
      "name": "reference-size",
      "values": [
        "standard",
        "larger",
        "largest"
      ],
      "defaultValue": "standard",
      "web": {
        "field": "reference-size",
        "storageKey": "dbw.reference-size"
      },
      "app": {
        "storageKey": "referenceSize"
      }
    }
  ]
}
